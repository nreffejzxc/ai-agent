# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your key. Never commit `.env`.
# ---------------------------------------------------------------------------

# Required, unless MOCK=true below. Get an API key from your AgentRouter
# console at https://agentrouter.org (prepaid credits, Anthropic models).
# ANTHROPIC_API_KEY also works if you prefer that name.
AGENTROUTER_API_KEY=sk-...your-key-here

# Optional. AgentRouter's Anthropic-compatible endpoint is the default; set
# this only if your relay uses a different host.
# ANTHROPIC_BASE_URL=https://agentrouter.org

# Optional. AgentRouter's gateway only accepts traffic that looks like the
# Claude Code client, so the app sends a claude-cli User-Agent plus beta
# headers when talking to an AgentRouter host. If you start getting
# "unauthorized client detected" again, AgentRouter has rotated which client
# versions it accepts — set this to the current Claude Code version.
# AGENTROUTER_CLIENT_UA=claude-cli/2.1.219 (external, sdk-cli)

# Set to true to test with canned replies: no API key needed, no calls made,
# nothing billed. Exercises the widget, streaming, CORS, rate limiting and your
# deployment — everything except whether the answers are any good. Mock replies
# are prefixed "[mock]" so they can't be mistaken for the real thing.
MOCK=false

# Which model answers. Defaults to deepseek-v4-flash: fast and cheap, but not an
# Anthropic model. Your AgentRouter plan also allows claude-opus-5 and
# claude-opus-4-8 (Anthropic Claude — strongest, but slower and costlier),
# plus glm-5.3 and gpt-5.6-sol. Pick any by name here. If a model errors,
# check Console → API Token → model restrictions.
AGENT_MODEL=deepseek-v4-flash

# Port the server listens on.
PORT=3000

# Which websites are allowed to talk to this server, comma-separated.
# Leave blank for local development (allows any origin, and warns on startup).
# In production set this to your real site, e.g.
#   ALLOWED_ORIGINS=https://yourbusiness.com,https://www.yourbusiness.com
ALLOWED_ORIGINS=

# Set to true ONLY if you run behind a proxy you control (Nginx, Cloudflare,
# Render, Fly). It makes the rate limiter read X-Forwarded-For; with no real
# proxy in front, a caller can forge that header and evade the limit.
TRUST_PROXY=false

# Rate limiting, per visitor IP.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=300

# Write conversations to logs/conversations.jsonl so you can see what customers
# ask. These contain real customer messages - treat the file as personal data.
LOG_TRANSCRIPTS=false
